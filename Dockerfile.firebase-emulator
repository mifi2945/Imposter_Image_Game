FROM node:22-trixie-slim

RUN apt-get update \
    && apt-get install --no-install-recommends -y openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global firebase-tools

WORKDIR /opt/firebase

COPY firebase.json firestore.rules ./
RUN firebase setup:emulators:firestore

EXPOSE 4000 8085

CMD ["firebase", "emulators:start", "--only", "firestore", "--project", "local-dev", "--import=/data", "--export-on-exit"]
